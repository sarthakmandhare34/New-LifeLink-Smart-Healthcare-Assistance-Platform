# ============================================================================
# LifeLink Smart Healthcare Assistance Platform - Environment Configuration
# ============================================================================
# Copy this file to .env and configure your local settings.
# Never commit real credentials or secrets to version control.
# ============================================================================

# ----------------------------------------------------------------------------
# 1. SERVER & PORT CONFIGURATION (Developer Configurable)
# ----------------------------------------------------------------------------
# Backend HTTP port (defaults to 4000; fallbacks 4000-4004 in dev runner)
PORT=4000

# ----------------------------------------------------------------------------
# 2. DATABASE CONFIGURATION (MySQL)
# ----------------------------------------------------------------------------
# Connection string format: mysql://<USER>:<PASSWORD>@<HOST>:<PORT>/<DATABASE>
DATABASE_URL="mysql://root:your_mysql_password@localhost:3306/lifelink"

# ----------------------------------------------------------------------------
# 3. AUTHENTICATION & SECURITY SECRETS
# ----------------------------------------------------------------------------
# Secret key used for signing session JWTs and secure cookies
JWT_SECRET="your-development-jwt-secret-min-32-chars"

# Optional: Demo doctor verification code for clinician role onboarding
# Default if unset: lifelink-controlled-clinician-secret-key-2026
LIFELINK_DEMO_DOCTOR_ACCESS_CODE="lifelink-controlled-clinician-secret-key-2026"

# ----------------------------------------------------------------------------
# 4. ARTIFICIAL INTELLIGENCE (Google Gemini)
# ----------------------------------------------------------------------------
# Required for clinical symptom analysis, urgency scoring, and triage routing
GEMINI_API_KEY="your-gemini-api-key-here"

# ----------------------------------------------------------------------------
# 5. GOOGLE OAUTH PROVIDER AUTHENTICATION (Optional)
# ----------------------------------------------------------------------------
# Server-only credentials for Google sign-in / registration
GOOGLE_OAUTH_CLIENT_ID="your-google-client-id.apps.googleusercontent.com"
GOOGLE_OAUTH_CLIENT_SECRET="your-google-client-secret"
AUTH_PUBLIC_BASE_URL="http://localhost:5173"

# ----------------------------------------------------------------------------
# 6. RUNTIME-GENERATED VARIABLES (DO NOT SET MANUALLY)
# ----------------------------------------------------------------------------
# VITE_API_PORT is automatically injected by scripts/dev.mjs during development
# to tell Vite which backend port to proxy /api and /uploads requests to.
# You do not need to configure this manually in your .env file.
# VITE_API_PORT=4000
